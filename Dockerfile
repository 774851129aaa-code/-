# استخدام بيئة Node.js الرسمية الخفيفة
FROM node:18-alpine

# تحديد مجلد العمل داخل الحاوية
WORKDIR /app

# نسخ ملف package.json (إن وجد) لتثبيت الحزم البسيطة
COPY package*.json ./

# تثبيت حزمة خادم ويب خفيف وسريع (serve) لخدمة الملفات الثابتة
RUN npm install -g serve

# نسخ بقية ملفات المشروع إلى الحاوية
COPY . .

# فتح المنفذ الذي سيعمل عليه السيرفر
EXPOSE 3000

# أمر تشغيل السيرفر باستخدام serve
CMD ["serve", "-s", ".", "-l", "3000"]
